# Git LFS tracking — matches worker LFS_EXTENSIONS
# Binary files tracked by LFS are stored as pointers in git,
# with actual content in the Cloudflare R2 bucket via custom worker.

*.pdf -text
*.doc -text
*.docx -text
*.ppt -text
*.pptx -text
*.xls -text
*.xlsx -text
*.jpg -text
*.jpeg -text
*.png -text
*.gif -text
*.webp -text
*.bmp -text
*.svg -text
*.zip -text
